# Metamorfos ODC Dashboard - Environment Configuration Example

# PORT is hardcoded by the infrastructure to 3000
PORT=3000

# ----------------------------------------------------------------------------
# LLM backend: OpenCode (replaces the manual NVIDIA/Kimi/Mistral fallback).
# Start the OpenCode sidecar before the Metamorfus dev server:
#   opencode serve --port 4096
# Configure your provider(s) once via `opencode auth login` and the cortex
# agent via `opencode agent`. The server.ts proxy then forwards every chat
# call to this URL.
# ----------------------------------------------------------------------------
OPENCODE_URL=http://localhost:4096
OPENCODE_AGENT=cortex

# ----------------------------------------------------------------------------
# Vision skill (Option A).
# Required by /api/vision and by the `vision_describe_protocol` skill in the
# organism's DNA library. Uses moonshotai/kimi-k3 by default; override with
# the VISION_MODEL env var if you prefer a different vision model on NIM.
# ----------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-your_key_here
VISION_MODEL=moonshotai/kimi-k3

# Optional: legacy provider keys. Kept here for reference / migrations where
# someone wants to bypass the bridge and call the providers directly. NOT used
# by the default flow (server.ts).
# KIMI_API_KEY=your_kimi_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
