{
  "name": "metamorfus-opencode",
  "version": "0.1.0",
  "description": "Unified monorepo for the Metamorfus ODC × OpenCode fusion — cognitive organism + AI coding tool.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "bun test",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist .turbo"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "typescript": "~5.8.2",
    "oxlint": "^0.16.0",
    "@types/node": "^22.14.0"
  }
}
